# Sumi: the red seal and the title live in the background picture (drawn for exactly 1920x1200),
# GRUB only draws the three entries in Mincho, the chosen one on soft red glass. No countdown.
title-text: ""
desktop-image: "{{DIR}}background.jpg"
desktop-color: "#0f0f14"
terminal-font: "{{F:jbmono-15}}"
terminal-left: "0"
terminal-top: "0"
terminal-width: "100%"
terminal-height: "100%"
terminal-border: "0"
+ boot_menu {
  left = 180 top = 444 width = 600 height = 560
  item_font = "{{F:shippori-32}}" item_color = "#b0aa96"
  selected_item_font = "{{F:shippori-32}}" selected_item_color = "#f2ecd2"
  item_height = 40 item_padding = 20 item_spacing = 52
  icon_width = 0 icon_height = 0 item_icon_space = 0
  selected_item_pixmap_style = "{{DIR}}select_*.png"
  scrollbar = false
}
