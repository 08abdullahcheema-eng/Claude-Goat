# Hagane: crop marks, a scale down the left edge, the menu in a hairline box with a bright top edge,
# the countdown runs along the bottom of the box
title-text: ""
desktop-image: "{{DIR}}background.jpg"
desktop-color: "#0b0b0c"
terminal-font: "{{F:inter-20}}"
terminal-left: "0"
terminal-top: "0"
terminal-width: "100%"
terminal-height: "100%"
terminal-border: "0"
+ label { left = 7% top = 7%+8 width = 40% height = 60 text = "鋼" font = "{{F:kanji-48}}" color = "#a9d1ff" }
+ label { left = 7% top = 12%+8 width = 40% height = 40 text = "H A G A N E" font = "{{F:inter-26}}" color = "#ffffff" }
+ label { left = 7% top = 16% width = 40% height = 30 text = "boot  ·  nixos" font = "{{F:inter-20}}" color = "#9a9aa0" }
+ boot_menu {
  left = 56%+13 top = 54% width = 35% height = 28%
  item_font = "{{F:inter-30}}" item_color = "#c8c8cc"
  selected_item_font = "{{F:inter-30}}" selected_item_color = "#ffffff"
  item_height = 60 item_padding = 26 item_spacing = 8
  icon_width = 40 icon_height = 40 item_icon_space = 22
  selected_item_pixmap_style = "{{DIR}}select_*.png"
  scrollbar = false
}
+ circular_progress {
  id = "__timeout__"
  left = 93%-96 top = 86%-96 width = 72 height = 72
  num_ticks = 24 ticks_disappear = true start_angle = -64
  center_bitmap = "{{DIR}}ring.png" tick_bitmap = "{{DIR}}tick.png"
}
+ label { left = 7% top = 92%+8 width = 40% height = 30 text = "Pfeiltasten wählen  ·  Enter startet  ·  e bearbeitet" font = "{{F:inter-20}}" color = "#6a6a70" }
