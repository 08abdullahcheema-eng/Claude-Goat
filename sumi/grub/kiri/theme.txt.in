# Kiri: one frosted card in the middle of the fog, everything centred, a soft pill marks the choice
title-text: ""
desktop-image: "{{DIR}}background.jpg"
desktop-color: "#101614"
terminal-font: "{{F:grotesk-15}}"
terminal-left: "0"
terminal-top: "0"
terminal-width: "100%"
terminal-height: "100%"
terminal-border: "0"
+ label { left = 32% top = 17% width = 36% height = 128 text = "霧" font = "{{F:kanji-90}}" color = "#a6d4ad" align = "center" }
+ label { left = 32% top = 30% width = 36% height = 60 text = "Kiri" font = "{{F:grotesk-45}}" color = "#ffffff" align = "center" }
+ boot_menu {
  left = 36% top = 41% width = 28% height = 34%
  item_font = "{{F:grotesk-22}}" item_color = "#cfd8d3"
  selected_item_font = "{{F:grotesk-22}}" selected_item_color = "#ffffff"
  item_height = 30 item_padding = 20 item_spacing = 24
  icon_width = 30 icon_height = 30 item_icon_space = 16
  selected_item_pixmap_style = "{{DIR}}select_*.png"
  scrollbar = false
}
+ circular_progress {
  id = "__timeout__"
  left = 50%-27 top = 73% width = 54 height = 54
  num_ticks = 24 ticks_disappear = true start_angle = -64
  center_bitmap = "{{DIR}}ring.png" tick_bitmap = "{{DIR}}tick.png"
}
+ label { left = 32% top = 81% width = 36% height = 22 text = "Pfeiltasten wählen  ·  Enter startet  ·  e bearbeitet" font = "{{F:grotesk-15}}" color = "#7d8a84" align = "center" }
