# Kiri: one frosted card in the middle of the fog, everything centred, a soft pill marks the choice
title-text: ""
desktop-image: "{{DIR}}background.jpg"
desktop-color: "#101614"
terminal-font: "{{F:grotesk-20}}"
terminal-left: "0"
terminal-top: "0"
terminal-width: "100%"
terminal-height: "100%"
terminal-border: "0"
+ label { left = 32% top = 17% width = 36% height = 170 text = "霧" font = "{{F:kanji-120}}" color = "#a6d4ad" align = "center" }
+ label { left = 32% top = 30% width = 36% height = 80 text = "Kiri" font = "{{F:grotesk-60}}" color = "#ffffff" align = "center" }
+ boot_menu {
  left = 36% top = 41% width = 28% height = 34%
  item_font = "{{F:grotesk-30}}" item_color = "#cfd8d3"
  selected_item_font = "{{F:grotesk-30}}" selected_item_color = "#ffffff"
  item_height = 40 item_padding = 26 item_spacing = 32
  icon_width = 40 icon_height = 40 item_icon_space = 22
  selected_item_pixmap_style = "{{DIR}}select_*.png"
  scrollbar = false
}
+ circular_progress {
  id = "__timeout__"
  left = 50%-36 top = 73% width = 72 height = 72
  num_ticks = 24 ticks_disappear = true start_angle = -64
  center_bitmap = "{{DIR}}ring.png" tick_bitmap = "{{DIR}}tick.png"
}
+ label { left = 32% top = 81% width = 36% height = 30 text = "Pfeiltasten wählen  ·  Enter startet  ·  e bearbeitet" font = "{{F:grotesk-20}}" color = "#7d8a84" align = "center" }
