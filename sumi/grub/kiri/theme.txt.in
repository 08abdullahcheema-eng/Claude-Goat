# Kiri: mark and title live in the background picture (drawn for exactly 1920x1200),
# GRUB only draws the entries, the chosen one on soft Kiri glass. No countdown.
title-text: ""
desktop-image: "{{DIR}}background.jpg"
desktop-color: "#101614"
terminal-font: "{{F:jbmono-15}}"
terminal-left: "0"
terminal-top: "0"
terminal-width: "100%"
terminal-height: "100%"
terminal-border: "0"
+ boot_menu {
  left = 180 top = 444 width = 600 height = 560
  item_font = "{{F:grotesk-32}}" item_color = "#c9d4ce"
  selected_item_font = "{{F:grotesk-32}}" selected_item_color = "#ffffff"
  item_height = 40 item_padding = 20 item_spacing = 52
  icon_width = 0 icon_height = 0 item_icon_space = 0
  selected_item_pixmap_style = "{{DIR}}select_*.png"
  scrollbar = false
}
